module example.com/app

go 1.21

// Мы зависим от example.com/greeting...
require example.com/greeting v0.0.0

// ...но такого модуля нет в интернете. Директива replace говорит Go брать
// его исходники из соседней папки на диске. Так удобно:
//   - разрабатывать библиотеку и приложение одновременно;
//   - временно подменить зависимость своим форком/патчем.
// Путь относительный — от папки с этим go.mod.
replace example.com/greeting => ../greeting
